QWidget { color: #26232a; font-size: 14px; }
QLabel { background: transparent; border: none; }
QLabel[role="muted"] { color: #59535a; font-size: 13px; }
QLabel[role="caption"], QLabel[role="relative"], QLabel[role="count"] { color: #59535a; font-size: 12px; }
QLabel[role="relative"][due="true"] { color: #713138; font-weight: 600; }
QLabel[role="month"] { font-size: 22px; font-weight: 650; }
QLabel[role="heading"] { font-size: 24px; font-weight: 650; }
QLabel[role="subheading"] { font-size: 17px; font-weight: 600; }
QLabel[role="field"] { color: #49444a; font-size: 13px; font-weight: 600; }
QLabel[role="error"] { color: #652b32; background: #f6eae7; border: 1px solid #cfaaab; border-radius: 5px; padding: 5px 8px; }
QFrame#calendarPanel { background: #fcfaf8; border: 1px solid #dedad5; border-radius: 11px; }
QFrame#divider { background: rgba(154,145,141,75); border: none; }
QFrame#viewSwitch { background: rgba(226,223,218,145); border: 1px solid rgba(190,185,179,150); border-radius: 7px; }
QPushButton {
    background: rgba(252,250,248,177); color: #26232a; border: 1px solid #c7c1bb; border-radius: 6px;
    padding: 4px 10px; min-height: 20px; font-size: 13px; font-weight: 550;
}
QPushButton:hover { background: #fcfaf8; border-color: #9a928e; }
QPushButton:pressed { background: #e2dfda; }
QPushButton[role="primary"] { color: #fcfaf8; background: #713138; border: 1px solid #713138; padding: 5px 12px; font-weight: 600; }
QPushButton[role="primary"]:hover { background: #622b32; }
QPushButton[role="primary"]:pressed { background: #54262d; }
QPushButton[role="icon"], QPushButton[role="link"], QPushButton[role="danger"] { background: transparent; border-color: transparent; }
QPushButton[role="icon"] { padding: 3px; }
QPushButton[role="link"] { color: #713138; padding: 2px 6px; }
QPushButton[role="danger"] { color: #713138; }
QPushButton[role="icon"]:hover, QPushButton[role="link"]:hover, QPushButton[role="danger"]:hover { background: #eae4e0; }
QPushButton[role="segment"] { background: transparent; color: #59535a; border: 1px solid transparent; padding: 3px 8px; border-radius: 5px; }
QPushButton[role="segment"]:hover { background: rgba(252,250,248,140); }
QPushButton[role="segment"]:checked { background: #fcfaf8; color: #713138; border-color: #cdc6c0; font-weight: 650; }
QPushButton[role="weekday"], QPushButton[role="more"] { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 0 1px; min-height: 0; }
QPushButton[role="weekday"][selected="true"] { color: #713138; background: #f1e8e5; border-bottom: 2px solid #713138; }
QPushButton[role="weekday"]:hover, QPushButton[role="more"]:hover { background: #eee9e5; }
QPushButton[role="more"] { text-align: left; color: #713138; font-size: 12px; padding-left: 4px; }
QPushButton[role="swatch"] { border: 1px solid transparent; border-radius: 14px; background: transparent; padding: 0; }
QPushButton[role="swatch"]:hover { background: #fcfaf8; }
QPushButton[role="swatch"]:checked { border-color: #713138; }
QPushButton:focus, QPushButton[role]:focus, QToolButton:focus { border: 2px solid #713138; }
QPushButton[role="primary"]:focus { background: #622b32; border: 2px solid #ecd2cf; }
QPushButton:disabled, QPushButton[role]:disabled { color: #716b6d; border-color: #dad6d1; background: #eae7e3; }
QLineEdit, QComboBox, QPlainTextEdit {
    color: #26232a; background: rgba(252,250,248,222); border: 1px solid #beb9b3; border-radius: 6px;
    padding: 5px 8px; selection-background-color: #713138; selection-color: #fcfaf8;
}
QComboBox:editable { padding-left: 1px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 23px; border: none; }
QComboBox::down-arrow { image: url(planner:chevron-down.svg); width: 12px; height: 12px; }
QComboBox QLineEdit { background: transparent; border: none; padding: 0 5px; }
QPlainTextEdit#detailNotes { background: rgba(252,250,248,133); border: 1px solid #d8d3ce; }
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QPlainTextEdit#detailNotes:focus { border: 2px solid #713138; }
QLineEdit[invalid="true"] { border: 2px solid #713138; background: #fbefed; }
QCheckBox, QRadioButton { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 2px; }
QCheckBox:focus, QRadioButton:focus { border-color: #713138; }
QComboBox QAbstractItemView, QMenu { background: #fcfaf8; color: #26232a; border: 1px solid #beb9b3; selection-background-color: #713138; selection-color: #fcfaf8; }
QMenu::item:selected { background: #713138; color: #fcfaf8; }
QMenu[desktopFrost="true"], QFrame[desktopFrost="true"] { background: rgba(252,250,248,224); border: 1px solid #ded9d4; }
QComboBox QAbstractItemView[desktopFrost="true"] { background: rgba(252,250,248,208); }
QScrollArea, QWidget#listContents, QTableView, QHeaderView { background: transparent; border: none; }
QListWidget#subjects, QListWidget#syncList { background: rgba(252,250,248,200); border: 1px solid #cfcbc5; border-radius: 7px; padding: 3px; }
QListWidget#subjects::item, QListWidget#syncList::item { padding: 3px 6px; border-radius: 4px; }
QListWidget#subjects::item:selected, QListWidget#syncList::item:selected { color: #fcfaf8; background: #713138; }
QListWidget#subjects:focus, QListWidget#syncList:focus { border: 2px solid #713138; }
QTableView#monthGrid { selection-background-color: transparent; }
QHeaderView::section { background: #fcfaf8; color: #59535a; border: none; border-bottom: 1px solid #d6d2cd; font-size: 12px; font-weight: 600; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #f0eeeb; }
QCalendarWidget QToolButton { color: #26232a; background: transparent; border: 1px solid transparent; padding: 4px; }
QCalendarWidget QToolButton:hover { background: #e2dfda; }
QCalendarWidget QToolButton:focus { border: 2px solid #713138; }
QCalendarWidget QAbstractItemView { background: #fcfaf8; alternate-background-color: #f0eeeb; color: #26232a; selection-background-color: #713138; selection-color: #fcfaf8; }
QScrollBar:vertical { border: none; background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #b6afa9; border-radius: 3px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { border: none; background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #b6afa9; border-radius: 3px; min-width: 24px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QToolTip { color: #fcfaf8; background: #383237; border: none; padding: 5px; }
QFrame#assistantDrawer { background: #faf8f5; border: 1px solid #beb9b3; border-radius: 11px; }
QFrame#assistantDrawer QPlainTextEdit { background: #fcfaf8; border: 1px solid #cbc5c0; border-radius: 6px; padding: 7px; }
QFrame#assistantDrawer QPlainTextEdit:focus { border: 2px solid #713138; }
