* text=auto
*.py text eol=lf
*.pyw text eol=lf
*.md text eol=lf
*.qss text eol=lf
*.ps1 text eol=crlf
*.ico binary
*.ttf binary
*.png binary
# Preserve the typefaces' upstream licence files byte for byte.
school_calendar/assets/fonts/LICENSE.md -text -whitespace
school_calendar/assets/fonts/*-OFL.txt -text -whitespace
# Bundled upstream notices contain Markdown heading underlines of seven equals signs.
installer/licenses/*.txt -text -whitespace conflict-marker-size=80
